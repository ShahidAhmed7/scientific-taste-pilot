# Command and output copied verbatim from the session log; timestamps and dates removed. Paths shortened:
#   <workdir> = folder holding the data files and scripts; <venv> = the Python environment; <other-project> = an unrelated project folder.

$ cd <workdir> && for f in test_ood_year test_extended test_ood_iclr; do curl -sL -A "research-reader/0.1" -o $f.jsonl https://huggingface.co/datasets/OpenMOSS-Team/SciJudgeBench/resolve/main/$f.jsonl; wc -l $f.jsonl; done; curl -sL -A "research-reader/0.1" https://huggingface.co/datasets/OpenMOSS-Team/SciJudgeBench/resolve/main/README.md | sed -n 1,80p | cut -c1-200; for v in .venv-benchmark .venv-mlx .venv-inference; do <other-project>/$v/bin/python -c "import sklearn,numpy;print('$v sklearn',sklearn.__version__)" 2>/dev/null; done

