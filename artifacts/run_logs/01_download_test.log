import json
r=json.loads(open('test.jsonl').readline())
def show(o,p=''):
  if isinstance(o,dict):
    for k,v in o.items(): show(v,p+k+'.')
  elif isinstance(o,list): print(p,'list',len(o), str(o)[:300])
  else: print(p, str(o)[:200])
show(r)"

